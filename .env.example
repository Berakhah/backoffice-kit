# Copy to .env before running docker compose up. No manual steps beyond that (00 hard
# constraint 5).

# Postgres password for run history, heal events, and the selector cache.
POSTGRES_PASSWORD=changeme

# HMAC key for redaction surrogates (bok_core.boundary.redact, Task 8). Never commit a
# real value here.
BOK_REDACTION_KEY=changeme

# Which data plane this deployment writes to: CLIENT (compose-only, no third-party
# processor) or DEMO (SYNTHETIC/PUBLIC only, hostable anywhere). See bok_core.boundary.egress.
BOK_DATA_PLANE=CLIENT
